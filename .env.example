# Hermes API Server. It must report features.runs_session_history=true.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_RUNTIME_NAME=Agent Workspace Hermes
HERMES_PROFILE=default
HERMES_EXECUTION_HOST=Agent Workspace server-side runtime

# Recommended explicitly in production: google|shared-secret|none.
# If omitted, a complete Google or shared-secret configuration is inferred;
# absent, partial, and invalid production configuration fails closed.
# Use none only behind a trusted private network or authenticated proxy.
AGENT_WORKSPACE_AUTH_MODE=
APP_BASE_URL=

# Shared-secret mode: at least 24 random characters.
APP_SHARED_SECRET=

# Google mode: all values required; keep AUTH_COOKIE_SECRET separate.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
AUTH_COOKIE_SECRET=

# Persistence and backups.
HERMES_WEB_UI_DATA_DIR=
HERMES_WEB_UI_BACKUP_DIR=

# Optional browser-visible branding. Changes require a rebuild.
NEXT_PUBLIC_AGENT_WORKSPACE_NAME=Agent Workspace
NEXT_PUBLIC_AGENT_WORKSPACE_SHORT_NAME=Agent
NEXT_PUBLIC_AGENT_DISPLAY_NAME=Agent
NEXT_PUBLIC_USER_DISPLAY_NAME=User

AGENT_WORKSPACE_SESSION_KEY=
# Legacy alias: HERMES_WEB_UI_SESSION_KEY=
AGENT_WORKSPACE_BASE_URL=
# Legacy aliases: KIRA_WORKSPACE_BASE_URL=, APP_BASE_URL=
AGENT_WORKSPACE_NOTIFY_INACTIVITY_MS=60000
# Legacy alias: KIRA_WORKSPACE_NOTIFY_INACTIVITY_MS=
AGENT_WORKSPACE_NOTIFY_SESSION_RATE_LIMIT_MS=60000
# Legacy alias: KIRA_WORKSPACE_NOTIFY_SESSION_RATE_LIMIT_MS=
AGENT_WORKSPACE_DEBUG_PERF=
# Legacy aliases: HERMES_WEB_UI_DEBUG_PERF=, KIRA_DEBUG_PERF=

HERMES_NOTIFY_ENABLED=false
HERMES_NOTIFY_RUN_SUCCESS_ENABLED=false
HERMES_NOTIFY_WEBHOOK_URL=
HERMES_NOTIFY_WEBHOOK_SECRET=
